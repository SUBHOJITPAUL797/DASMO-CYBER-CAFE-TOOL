rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Photo Print App Approvals
    match /users/{userId} {
      allow read, write: if true; 
    }

    // Doc Scanner App Approvals
    match /dasmo_doc_scanner/{userId} {
      allow read, write: if true;
    }

    // Scanned Documents Metadata
    match /dasmo_doc_scanner_documents/{docId} {
      allow read, write: if true;
    }
    
    // Future-proofing for other collections
    match /todos/{todoId} {
      allow read, write: if true;
    }
  }
}
